/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Scripts and styles are re-checked on every visit (a cheap 304 when unchanged), so a browser can never
# run an old file next to a new one right after an update.
/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/demo/*
  Cache-Control: public, max-age=86400

/firebase-messaging-sw.js
  Cache-Control: no-cache
